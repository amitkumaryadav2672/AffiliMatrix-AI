{
  "name": "ai-affiliate-saas",
  "version": "1.0.0",
  "description": "AI-powered affiliate marketing platform automating workflows from product discovery to social publishing and analytics",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "build:frontend": "npm --prefix frontend run build",
    "start:backend": "npm --prefix backend start",
    "worker:content": "node backend/src/jobs/content.worker.js",
    "worker:video": "node backend/src/jobs/video.worker.js",
    "worker:publishing": "node backend/src/jobs/publishing.worker.js",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
