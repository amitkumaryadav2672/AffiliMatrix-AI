# ==========================================
# AffiliMatrix AI - Docker Environment Setup
# Copy to .env in the root directory if customizing credentials
# ==========================================

# Port Configuration
BACKEND_PORT=5000
FRONTEND_PORT=80
FRONTEND_ALT_PORT=5173

# Database & Cache (handled automatically via Docker service names)
MONGODB_URI=mongodb://mongodb:27017/ai-affiliate-saas
REDIS_HOST=redis
REDIS_PORT=6379

# AI API Providers (Optional - built-in marketing intelligence engine active by default)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Social Platform API Keys (Optional - simulated sandbox active by default)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
